    <statement><p>The graph of <m>y= x^2</m> is given below:</p>
<image xmlns:pi="http://pretextbook.org/2020/pretext/internal" pi:generated="webwork/images/Library__Rochester__setAlgebra19FunTransforms__p1-image-1.png" width="33%"/>
<p>Find a formula for each of the transformations whose graphs
are given below.</p>
<p>a)</p>
<image xmlns:pi="http://pretextbook.org/2020/pretext/internal" pi:generated="webwork/images/Library__Rochester__setAlgebra19FunTransforms__p1-image-2.png" width="33%"/>
<p><m>y =</m> <fillin characters="30" name="AnSwEr0001"/></p>
<p>b)</p>
<image xmlns:pi="http://pretextbook.org/2020/pretext/internal" pi:generated="webwork/images/Library__Rochester__setAlgebra19FunTransforms__p1-image-3.png" width="33%"/>
<p><m>y =</m> <fillin characters="30" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>\left(x+\left(-2\right)\right)^{2}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>x^{2}+1</m>
      </p>
    </answer>
