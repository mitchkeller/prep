    <statement><p>Determine whether each of the following expressions is Positive or Negative without using a calculator.</p>
<p><m>\sin(70^\circ)</m>
<var form="buttons">
<li>
<p>Negative</p>
</li>
<li>
<p>Positive</p>
</li>
</var></p>
<p><m>\cos(138^\circ)</m>
<var form="buttons">
<li>
<p>Negative</p>
</li>
<li>
<p>Positive</p>
</li>
</var></p>
<p><m>\sin(\frac{15\pi}{16})</m>
<var form="buttons">
<li>
<p>Positive</p>
</li>
<li>
<p>Negative</p>
</li>
</var></p>
<p><m>\cos(\frac{20\pi}{21})</m>
<var form="buttons">
<li>
<p>Negative</p>
</li>
<li>
<p>Positive</p>
</li>
</var></p>
</statement>
